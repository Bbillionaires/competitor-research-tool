<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Competitive Intelligence Platform</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://js.stripe.com/v3/"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap');
        
        :root {
            --primary: #00d9ff;
            --secondary: #ff006e;
            --success: #00ff88;
            --bg-space: #0a0e27;
            --bg-card: #141b3d;
            --text: #e0e6ff;
            --text-dim: #8891b8;
            --border: #1e2d5f;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Space Mono', monospace;
            background: var(--bg-space);
            color: var(--text);
            min-height: 100vh;
        }
        
        .space-bg {
            position: fixed;
            width: 100%;
            height: 100%;
            background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);
            z-index: 0;
        }
        
        .container {
            position: relative;
            z-index: 10;
            max-width: 1600px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        /* HEADER */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding: 20px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 15px;
        }
        
        h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .tier-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
        }
        
        .tier-free { background: rgba(136, 145, 184, 0.2); color: var(--text-dim); }
        .tier-pro { background: rgba(0, 217, 255, 0.2); color: var(--primary); }
        .tier-business { background: rgba(255, 0, 110, 0.2); color: var(--secondary); }
        .tier-enterprise { background: rgba(0, 255, 136, 0.2); color: var(--success); }
        
        button {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: #000;
            border: none;
            padding: 12px 24px;
            border-radius: 10px;
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 217, 255, 0.5);
        }
        
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        /* LOGIN MODAL */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background: var(--bg-card);
            border: 2px solid var(--primary);
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
        }
        
        .modal h2 {
            font-family: 'Orbitron', sans-serif;
            color: var(--primary);
            margin-bottom: 20px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-dim);
            font-size: 0.9rem;
        }
        
        input {
            width: 100%;
            background: var(--bg-space);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 12px;
            border-radius: 8px;
            font-family: 'Space Mono', monospace;
        }
        
        input:focus {
            outline: none;
            border-color: var(--primary);
        }
        
        /* PRICING MODAL */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin: 30px 0;
        }
        
        .pricing-card {
            background: var(--bg-space);
            border: 2px solid var(--border);
            border-radius: 15px;
            padding: 30px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .pricing-card:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
        }
        
        .pricing-card.selected {
            border-color: var(--success);
            background: rgba(0, 255, 136, 0.1);
        }
        
        .price {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            color: var(--primary);
            margin: 15px 0;
        }
        
        .features {
            text-align: left;
            margin-top: 20px;
        }
        
        .features li {
            margin: 8px 0;
            font-size: 0.85rem;
            color: var(--text-dim);
        }
        
        /* USAGE LIMITS */
        .usage-bar {
            background: var(--bg-space);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .usage-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }
        
        .progress-bar {
            width: 100%;
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
        }
        
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            transition: width 0.3s;
        }
        
        /* PAYWALL OVERLAY */
        .paywall {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 14, 39, 0.95);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        
        .paywall.active {
            display: flex;
        }
        
        .paywall-content {
            background: var(--bg-card);
            border: 3px solid var(--secondary);
            border-radius: 20px;
            padding: 50px;
            max-width: 600px;
            text-align: center;
        }
        
        .paywall h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            color: var(--secondary);
            margin-bottom: 20px;
        }
        
        /* SEARCH PANEL */
        .search-panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
        }
        
        .search-grid {
            display: grid;
            grid-template-columns: 2fr 1fr auto;
            gap: 20px;
        }
        
        select {
            background: var(--bg-space);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 12px;
            border-radius: 8px;
            font-family: 'Space Mono', monospace;
        }
        
        /* RESULTS */
        .results-section {
            display: none;
        }
        
        .results-section.active {
            display: block;
        }
        
        .metric-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
        }
        
        .metric-value {
            font-family: 'Orbitron', sans-serif;
            font-size: 2rem;
            color: var(--primary);
            margin: 10px 0;
        }
        
        .error-message {
            background: rgba(255, 0, 110, 0.1);
            border: 2px solid var(--secondary);
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        
        @media (max-width: 1200px) {
            .pricing-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .search-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="space-bg"></div>
    
    <div class="container">
        <!-- Header with User Info -->
        <header>
            <h1>🚀 COMPETITIVE INTELLIGENCE</h1>
            <div class="user-info" id="user-info">
                <span class="tier-badge tier-free" id="tier-badge">Free Tier</span>
                <button onclick="showPricing()">⬆️ Upgrade</button>
                <button onclick="logout()">Logout</button>
            </div>
        </header>
        
        <!-- Usage Limits -->
        <div class="usage-bar" id="usage-bar">
            <div class="usage-label">
                <span>Searches Used</span>
                <span><span id="searches-used">0</span> / <span id="searches-limit">1</span></span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" id="usage-fill" style="width: 0%"></div>
            </div>
        </div>
        
        <!-- Search Panel -->
        <div class="search-panel">
            <div class="search-grid">
                <div>
                    <label>Industry Keywords</label>
                    <input type="text" id="query" placeholder="e.g., law firms jacksonville fl">
                </div>
                <div>
                    <label>Max Results</label>
                    <select id="max-results">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div>
                    <label style="opacity: 0;">Search</label>
                    <button onclick="runSearch()">🔍 Search</button>
                </div>
            </div>
        </div>
        
        <!-- Results Section -->
        <div class="results-section" id="results">
            <div id="results-content"></div>
        </div>
    </div>
    
    <!-- Login Modal -->
    <div class="modal active" id="login-modal">
        <div class="modal-content">
            <h2>Welcome Back</h2>
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="login-email" placeholder="you@example.com">
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="login-password" placeholder="••••••••">
            </div>
            <button onclick="login()" style="width: 100%; margin-bottom: 10px;">Login</button>
            <button onclick="showSignup()" style="width: 100%; background: var(--bg-space);">Create Account</button>
            <p style="text-align: center; margin-top: 20px; color: var(--text-dim); font-size: 0.85rem;">
                Demo: admin@test.com / password
            </p>
        </div>
    </div>
    
    <!-- Pricing Modal -->
    <div class="modal" id="pricing-modal">
        <div class="modal-content" style="max-width: 1000px;">
            <h2>Choose Your Plan</h2>
            <div class="pricing-grid">
                <!-- Free -->
                <div class="pricing-card" onclick="selectPlan('free')">
                    <h3>Free</h3>
                    <div class="price">$0</div>
                    <p style="color: var(--text-dim); font-size: 0.85rem;">per month</p>
                    <ul class="features">
                        <li>✓ 1 search/month</li>
                        <li>✓ 10 results max</li>
                        <li>✓ Basic data</li>
                        <li>✗ No keywords</li>
                        <li>✗ No executives</li>
                        <li>✗ No exports</li>
                    </ul>
                </div>
                
                <!-- Pro -->
                <div class="pricing-card" onclick="selectPlan('pro')">
                    <h3>Pro</h3>
                    <div class="price">$99</div>
                    <p style="color: var(--text-dim); font-size: 0.85rem;">per month</p>
                    <ul class="features">
                        <li>✓ 10 searches/month</li>
                        <li>✓ 50 results max</li>
                        <li>✓ Keywords included</li>
                        <li>✓ Executive finder</li>
                        <li>✓ CSV/Excel export</li>
                        <li>✓ Charts & graphs</li>
                    </ul>
                </div>
                
                <!-- Business -->
                <div class="pricing-card" onclick="selectPlan('business')">
                    <h3>Business</h3>
                    <div class="price">$299</div>
                    <p style="color: var(--text-dim); font-size: 0.85rem;">per month</p>
                    <ul class="features">
                        <li>✓ 50 searches/month</li>
                        <li>✓ 100 results max</li>
                        <li>✓ All Pro features</li>
                        <li>✓ API access</li>
                        <li>✓ Priority support</li>
                        <li>✓ Team accounts (5)</li>
                    </ul>
                </div>
                
                <!-- Enterprise -->
                <div class="pricing-card" onclick="selectPlan('enterprise')">
                    <h3>Enterprise</h3>
                    <div class="price">$999</div>
                    <p style="color: var(--text-dim); font-size: 0.85rem;">per month</p>
                    <ul class="features">
                        <li>✓ Unlimited searches</li>
                        <li>✓ Unlimited results</li>
                        <li>✓ All features</li>
                        <li>✓ White-label option</li>
                        <li>✓ Dedicated support</li>
                        <li>✓ Custom integrations</li>
                    </ul>
                </div>
            </div>
            <div style="text-align: center; margin-top: 20px;">
                <button onclick="hidePricing()">Cancel</button>
            </div>
        </div>
    </div>
    
    <!-- Paywall Overlay -->
    <div class="paywall" id="paywall">
        <div class="paywall-content">
            <h2>🔒 Limit Reached</h2>
            <p style="font-size: 1.2rem; margin: 20px 0;">
                You've used all your searches for this month.
            </p>
            <p style="color: var(--text-dim); margin-bottom: 30px;">
                Upgrade to Pro for 10 searches/month, executive finder, and more!
            </p>
            <button onclick="showPricing()" style="font-size: 1.2rem; padding: 16px 40px;">
                ⬆️ Upgrade Now
            </button>
            <br><br>
            <button onclick="hidePaywall()" style="background: var(--bg-space);">
                Maybe Later
            </button>
        </div>
    </div>
    
    <script>
        // USER SESSION MANAGEMENT
        let currentUser = null;
        const PLANS = {
            free: { searches: 1, maxResults: 10, price: 0 },
            pro: { searches: 10, maxResults: 50, price: 99 },
            business: { searches: 50, maxResults: 100, price: 299 },
            enterprise: { searches: 999999, maxResults: 999999, price: 999 }
        };
        
        // Initialize
        function init() {
            const savedUser = localStorage.getItem('user');
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                showDashboard();
            } else {
                document.getElementById('login-modal').classList.add('active');
            }
        }
        
        // Login
        function login() {
            const email = document.getElementById('login-email').value;
            const password = document.getElementById('login-password').value;
            
            // Demo login (replace with real API call)
            if (email && password) {
                currentUser = {
                    email: email,
                    tier: 'free',
                    searchesUsed: 0,
                    searchesLimit: PLANS.free.searches
                };
                
                localStorage.setItem('user', JSON.stringify(currentUser));
                document.getElementById('login-modal').classList.remove('active');
                showDashboard();
            } else {
                alert('Please enter email and password');
            }
        }
        
        function logout() {
            localStorage.removeItem('user');
            location.reload();
        }
        
        function showDashboard() {
            // Update UI
            const tierBadge = document.getElementById('tier-badge');
            tierBadge.textContent = currentUser.tier.charAt(0).toUpperCase() + currentUser.tier.slice(1) + ' Tier';
            tierBadge.className = 'tier-badge tier-' + currentUser.tier;
            
            // Update usage
            document.getElementById('searches-used').textContent = currentUser.searchesUsed;
            document.getElementById('searches-limit').textContent = currentUser.searchesLimit;
            
            const percent = (currentUser.searchesUsed / currentUser.searchesLimit) * 100;
            document.getElementById('usage-fill').style.width = percent + '%';
            
            // Show/hide paywall
            if (currentUser.searchesUsed >= currentUser.searchesLimit) {
                document.getElementById('paywall').classList.add('active');
            }
        }
        
        // Search
        async function runSearch() {
            // Check limits
            if (currentUser.searchesUsed >= currentUser.searchesLimit) {
                document.getElementById('paywall').classList.add('active');
                return;
            }
            
            const query = document.getElementById('query').value.trim();
            if (!query) {
                alert('Please enter a search query');
                return;
            }
            
            const maxResults = parseInt(document.getElementById('max-results').value);
            
            // Check tier limits
            if (maxResults > PLANS[currentUser.tier].maxResults) {
                alert(`Your ${currentUser.tier} plan allows max ${PLANS[currentUser.tier].maxResults} results. Upgrade for more!`);
                return;
            }
            
            // Show loading
            document.getElementById('results-content').innerHTML = `
                <div style="text-align: center; padding: 60px;">
                    <div style="width: 60px; height: 60px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; margin: 0 auto 20px; animation: spin 1s linear infinite;"></div>
                    <p>Analyzing competitors...</p>
                </div>
            `;
            document.getElementById('results').classList.add('active');
            
            try {
                const response = await fetch('http://localhost:5000/api/search', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query, max_results: maxResults })
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Search failed');
                }
                
                const data = await response.json();
                
                // Increment usage
                currentUser.searchesUsed++;
                localStorage.setItem('user', JSON.stringify(currentUser));
                showDashboard();
                
                // Display results
                displayResults(data);
                
            } catch (error) {
                console.error('Search error:', error);
                document.getElementById('results-content').innerHTML = `
                    <div class="error-message">
                        <h3 style="color: var(--secondary); margin-bottom: 10px;">❌ Search Failed</h3>
                        <p>${error.message}</p>
                        <p style="margin-top: 10px; color: var(--text-dim); font-size: 0.9rem;">
                            Make sure:<br>
                            • Flask backend is running (python flask_backend.py)<br>
                            • Auto-patcher was run (python auto_patcher_v2_complete.py)<br>
                            • All packages are installed
                        </p>
                    </div>
                `;
            }
        }
        
        function displayResults(data) {
            const competitors = data.competitors || [];
            let html = `
                <div style="background: var(--bg-card); border: 1px solid var(--success); border-radius: 15px; padding: 30px; margin-bottom: 20px;">
                    <h2 style="color: var(--success); margin-bottom: 20px;">✅ Analysis Complete!</h2>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
                        <div class="metric-card">
                            <div style="color: var(--text-dim);">Competitors Found</div>
                            <div class="metric-value">${competitors.length}</div>
                        </div>
                        <div class="metric-card">
                            <div style="color: var(--text-dim);">CI Score</div>
                            <div class="metric-value">${data.intelligence?.competitiveness_score || 0}</div>
                        </div>
                        <div class="metric-card">
                            <div style="color: var(--text-dim);">Executives Found</div>
                            <div class="metric-value">${competitors.reduce((sum, c) => sum + (parseInt(c.executive_count) || 0), 0)}</div>
                        </div>
                        <div class="metric-card">
                            <div style="color: var(--text-dim);">Potential Leads</div>
                            <div class="metric-value">${competitors.reduce((sum, c) => sum + (parseInt(c.mention_count) || 0), 0)}</div>
                        </div>
                    </div>
                </div>
                
                <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 15px; padding: 30px;">
                    <h3 style="color: var(--primary); margin-bottom: 20px;">Top Competitors</h3>
                    <table style="width: 100%;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border);">
                                <th style="padding: 12px; text-align: left; color: var(--primary);">Company</th>
                                <th style="padding: 12px; text-align: left; color: var(--primary);">Score</th>
                                <th style="padding: 12px; text-align: left; color: var(--primary);">Executives</th>
                                <th style="padding: 12px; text-align: left; color: var(--primary);">Traffic</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            competitors.slice(0, 10).forEach(comp => {
                html += `
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 12px;"><strong>${comp.name || comp.domain}</strong></td>
                        <td style="padding: 12px;">${comp.competitor_score || 0}</td>
                        <td style="padding: 12px;">${comp.executive_count || 0}</td>
                        <td style="padding: 12px;">${formatNumber(comp.traffic_estimate)}</td>
                    </tr>
                `;
            });
            
            html += `
                        </tbody>
                    </table>
                    <div style="text-align: center; margin-top: 20px;">
                        <button onclick="exportToCSV()">📊 Export to CSV</button>
                    </div>
                </div>
            `;
            
            document.getElementById('results-content').innerHTML = html;
        }
        
        function formatNumber(num) {
            num = parseInt(num) || 0;
            if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
            if (num >= 1000) return (num / 1000).toFixed(0) + 'K';
            return num;
        }
        
        function exportToCSV() {
            alert('Export functionality - would download CSV file with all data');
        }
        
        // Pricing
        function showPricing() {
            document.getElementById('pricing-modal').classList.add('active');
        }
        
        function hidePricing() {
            document.getElementById('pricing-modal').classList.remove('active');
        }
        
        function hidePaywall() {
            document.getElementById('paywall').classList.remove('active');
        }
        
        function selectPlan(plan) {
            if (plan === 'free') {
                alert('You are already on the free plan');
                return;
            }
            
            // In production, integrate Stripe here
            const price = PLANS[plan].price;
            const confirmed = confirm(`Upgrade to ${plan.toUpperCase()} for $${price}/month?`);
            
            if (confirmed) {
                // Simulate upgrade
                currentUser.tier = plan;
                currentUser.searchesLimit = PLANS[plan].searches;
                currentUser.searchesUsed = 0;
                localStorage.setItem('user', JSON.stringify(currentUser));
                
                hidePricing();
                hidePaywall();
                showDashboard();
                
                alert(`✅ Successfully upgraded to ${plan.toUpperCase()}!`);
            }
        }
        
        function showSignup() {
            alert('Signup functionality - would create new account');
        }
        
        // Initialize on load
        init();
    </script>
    
    <style>
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</body>
</html>
